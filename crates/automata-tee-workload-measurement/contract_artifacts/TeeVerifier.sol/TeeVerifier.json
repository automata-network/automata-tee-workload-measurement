snpAttestation\",\"outputs\":[{\"internalType\":\"contract ISnpAttestation\",\"name\":\"\",\"type\":\"address\"}],\"stateMutability\":\"view\",\"type\":\"function\"},{\"inputs\":[{\"components\":[{\"internalType\":\"enum VerificationBackendType\",\"name\":\"verificationBackendType\",\"type\":\"uint8\"},{\"internalType\":\"enum TEEType\",\"name\":\"teeType\",\"type\":\"uint8\"},{\"internalType\":\"bytes\",\"name\":\"data\",\"type\":\"bytes\"}],\"internalType\":\"struct TeeReport\",\"name\":\"teeReport\",\"type\":\"tuple\"}],\"name\":\"verifyTeeReport\",\"outputs\":[{\"components\":[{\"internalType\":\"bool\",\"name\":\"valid\",\"type\":\"bool\"},{\"internalType\":\"bytes\",\"name\":\"reportData\",\"type\":\"bytes\"},{\"internalType\":\"enum TEEType\",\"name\":\"teeType\",\"type\":\"uint8\"}],\"internalType\":\"struct TeeVerificationResult\",\"name\":\"result\",\"type\":\"tuple\"}],\"stateMutability\":\"nonpayable\",\"type\":\"function\"}],\"devdoc\":{\"details\":\"Dispatches verification to vendor-specific contracts (DCAP for Intel TDX, SNP for AMD SEV-SNP)      and extracts reportData from the verified output. Designed to be referenced externally.\",\"kind\":\"dev\",\"methods\":{\"constructor\":{\"params\":{\"_dcapAttestation\":\"Address of the DCAP attestation verifier contract\",\"_snpAttestation\":\"Address of the SNP attestation verifier contract\"}},\"extractDcapReportData(bytes)\":{\"details\":\"Extracts the 64-byte reportData from a DCAP quote body\",\"params\":{\"quoteBody\":\"The TD10 or TD15 quote body (output of extractDcapQuoteBody)\"},\"returns\":{\"reportData\":\"The extracted 64-byte reportData field at offset 520\"}},\"extractSnpReportData(bytes)\":{\"details\":\"Extracts reportData from SNP raw report bytes\",\"params\":{\"rawReport\":\"The SNP raw report bytes from VerifierJournal\"},\"returns\":{\"reportData\":\"The extracted 64-byte REPORT_DATA field\"}},\"verifyTeeReport((uint8,uint8,bytes))\":{\"params\":{\"teeReport\":\"The TEE attestation report to verify (contains backend type, TEE type, and data)\"},\"returns\":{\"result\":\"Verification result containing validity status, report data, and TEE type\"}}},\"stateVariables\":{\"DCAP_MIN_OUTPUT_LEN\":{\"details\":\"Minimum valid quote body length (must contain reportData)\"},\"DCAP_QUOTE_BODY_OFFSET\":{\"details\":\"Offset of quote body in DCAP output (2+2+1+6 byte header)\"},\"DCAP_REPORT_DATA_START\":{\"details\":\"Offset of reportData within quote body\"},\"DCAP_TCB_STATUS_OFFSET\":{\"details\":\"Offset of tcbStatus in DCAP output (2-byte version + 2-byte quoteBodyType)\"},\"QUOTE_BODY_TYPE_TD10\":{\"details\":\"Quote body type identifier for TD10 (TDX 1.0) format\"},\"QUOTE_BODY_TYPE_TD15\":{\"details\":\"Quote body type identifier for TD15 (TDX 1.5) format\"},\"REPORT_DATA_SIZE\":{\"details\":\"Size of reportData field in bytes\"},\"SNP_MIN_REPORT_LEN\":{\"details\":\"Minimum valid SNP report length (must contain REPORT_DATA)\"},\"SNP_REPORT_DATA_OFFSET\":{\"details\":\"Offset of REPORT_DATA in AMD SEV-SNP raw report (per AMD spec)\"},\"TCB_STATUS_OK\":{\"details\":\"Accepted DCAP TCB statuses: OK and TCB_SW_HARDENING_NEEDED.\"},\"TD10_QUOTE_BODY_SIZE\":{\"details\":\"Size of TD10 quote body in bytes\"},\"TD15_QUOTE_BODY_SIZE\":{\"details\":\"Size of TD15 quote body in bytes\"},\"TD_ATTRIBUTES_DEBUG_MASK\":{\"details\":\"TD_ATTRIBUTES.DEBUG is bit 0.\"},\"TD_ATTRIBUTES_OFFSET\":{\"details\":\"Offset of tdAttributes within TD10/TD15 quote body\"}},\"title\":\"TeeVerifier\",\"version\":1},\"userdoc\":{\"errors\":{\"DcapReportDataOob(uint256,uint256)\":[{\"notice\":\"DCAP report-data slice would read past the end of the quote body\"}],\"DcapVerificationFailed(bytes)\":[{\"notice\":\"The upstream DCAP verifier returned !success. The full output is included         so off-chain decoders can surface the underlying reason.\"}],\"SnpReportHashMismatch(bytes32,bytes32)\":[{\"notice\":\"The supplied SNP raw report does not hash to the journal's reportHash.         Indicates the report body was not the one the ZK proof attested to.\"}],\"SnpReportTooShort(uint256,uint256)\":[{\"notice\":\"SNP raw report bytes are shorter than the minimum required to contain REPORT_DATA\"}],\"SnpVerificationFailed(uint8)\":[{\"notice\":\"The upstream SNP verifier returned a non-Success VerificationResult.\"}],\"TeeReportTooShort(uint256,uint256)\":[{\"notice\":\"TEE report bytes are shorter than the minimum required for the format being parsed\"}],\"UnsupportedBackendType(uint8,uint8)\":[{\"notice\":\"Verification backend type is not supported for this TEE type\"}],\"UnsupportedDcapBodyType(uint16)\":[{\"notice\":\"DCAP quote bodyType field is neither TD10 (2) nor TD15 (3)\"}],\"UnsupportedTeeType(uint8)\":[{\"notice\":\"TEE type is not supported by this verifier\"}]},\"kind\":\"user\",\"methods\":{\"TEE_VERIFIER_VERSION()\":{\"notice\":\"Contract version\"},\"constructor\":{\"notice\":\"Initializes the TeeVerifier with vendor-specific attestation contracts\"},\"dcapAttestation()\":{\"notice\":\"DCAP attestation verifier contract for Intel TDX quotes\"},\"snpAttestation()\":{\"notice\":\"SNP attestation verifier contract for AMD SEV-SNP reports\"},\"verifyTeeReport((uint8,uint8,bytes))\":{\"notice\":\"Verifies a TEE attestation report\"}},\"notice\":\"Standalone contract for verifying TEE attestation reports across multiple backends\",\"version\":1}},\"settings\":{\"compilationTarget\":{\"src/TeeVerifier.sol\":\"TeeVerifier\"},\"evmVersion\":\"prague\",\"libraries\":{},\"metadata\":{\"bytecodeHash\":\"ipfs\"},\"optimizer\":{\"enabled\":true,\"runs\":200},\"remappings\":[\":@automata-network/automata-tpm-attestation/=lib/automata-tpm-attestation/src/\",\":@openzeppelin/contracts-upgradeable/=lib/openzeppelin-contracts-upgradeable/contracts/\",\":@openzeppelin/contracts/=lib/openzeppelin-contracts/contracts/\",\":@solady/=lib/solady/src/\",\":automata-tpm-attestation/=lib/automata-tpm-attestation/\",\":erc4626-tests/=lib/openzeppelin-contract